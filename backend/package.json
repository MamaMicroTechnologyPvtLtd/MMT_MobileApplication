{
  "name": "mmt-backend",
  "version": "0.1.0",
  "description": "MMT Mobile Application backend — Node.js + Express + PostgreSQL API for the Customer / Internal / Supplier interfaces.",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
