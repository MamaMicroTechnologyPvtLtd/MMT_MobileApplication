# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mmt

# Auth
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=30d

# Employee registration is restricted to these company email domains
# (comma-separated). Only these can self-register as internal staff.
EMPLOYEE_EMAIL_DOMAINS=mamamicrotechnology.com

# Server
PORT=4000

# File uploads (quotation PDFs, invoices, delivery docs)
UPLOAD_DIR=uploads

# WhatsApp. Without these, the app returns wa.me deep links (tap to send per
# supplier). Set both to enable true one-click server-side sending via the
# WhatsApp Business Cloud API.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
WHATSAPP_DEFAULT_CC=91
