{
  "expo": {
    "name": "MMT",
    "slug": "mmt-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "primaryColor": "#0F766E",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0F766E"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": { "supportsTablet": true },
    "android": {
      "package": "com.mamamicro.mmt"
    },
    "web": { "bundler": "metro" },
    "extra": {
      "apiBaseUrl": "http://localhost:4000/api"
    }
  }
}
